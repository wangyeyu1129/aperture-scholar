{
  "$defs": {
    "Paper": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "abstract": {
          "default": "",
          "title": "Abstract",
          "type": "string"
        },
        "year": {
          "anyOf": [
            {
              "maximum": 9999,
              "minimum": 1000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year"
        },
        "doi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doi"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "title": "Paper",
      "type": "object"
    },
    "Section": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "heading": {
          "minLength": 1,
          "title": "Heading",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "source": {
          "default": "paper",
          "enum": [
            "paper",
            "review"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "id",
        "heading",
        "text"
      ],
      "title": "Section",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "paper": {
      "$ref": "#/$defs/Paper"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/Section"
      },
      "title": "Sections",
      "type": "array"
    }
  },
  "required": [
    "paper",
    "sections"
  ],
  "title": "Document",
  "type": "object"
}
